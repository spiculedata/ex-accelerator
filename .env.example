# Copy to .env before running `docker compose up` (see README quickstart).
# Never commit your real .env.

# Where bind-mounted data (Postgres, uploads, models) lives. Use ./data for a local
# try-out; the production default (if unset) is /data.
DATA_DIR=./data

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-before-sharing-this-machine
POSTGRES_DB=analytics
POSTGRES_PORT=5432

# Auth (required). Generate with: openssl rand -hex 32
SESSION_SECRET=

# Allow login over plain http://localhost. Set to true when serving over HTTPS.
COOKIE_SECURE=false

# First admin account, created only while the user table is empty.
# Password must be at least 12 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Only needed when pulling/pushing images from a registry (production deploys).
# REGISTRY=rg.fr-par.scw.cloud/your-namespace
# TAG=latest
