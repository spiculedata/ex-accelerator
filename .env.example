# Copy to .env before running `docker compose up` (see README quickstart).
# Never commit your real .env.

# Where bind-mounted data (Postgres, uploads, models) lives. Use ./data for a local
# try-out; the production default (if unset) is /data.
DATA_DIR=./data

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-before-sharing-this-machine
POSTGRES_DB=analytics
POSTGRES_PORT=5432

# Auth (required). Generate with: openssl rand -hex 32
SESSION_SECRET=

# Allow login over plain http://localhost. Set to true when serving over HTTPS.
COOKIE_SECURE=false

# JupyterLab for the docker compose route. JUPYTER_TOKEN is required there: the `jupyter` container refuses to start
# without it, and the app uses it (with JUPYTER_URL) to open that service for admins. Generate with: openssl rand -hex 32
# It is NOT used by `npm run dev` or `npm run dev:jupyter`, which create a random token for every launch; set
# JUPYTER_URL and JUPYTER_TOKEN there only to point the dev server at a Jupyter you run yourself.
# The compose service is published on 127.0.0.1:8888; JUPYTER_ALLOW_ORIGIN must match the URL you open the app on.
JUPYTER_TOKEN=
# JUPYTER_ALLOW_ORIGIN=http://localhost:3000
# JUPYTER_URL=http://localhost:8888

# First admin account, created only while the user table is empty.
# Password must be at least 12 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Only needed when pulling/pushing images from a registry (production deploys).
# REGISTRY=rg.fr-par.scw.cloud/your-namespace
# TAG=latest
