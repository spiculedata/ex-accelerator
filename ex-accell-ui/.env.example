# PostgreSQL Database Configuration
# Used for unified analytics with pg_duckdb extension

# PostgreSQL connection settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=social_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Connection pool settings
POSTGRES_POOL_MAX=20
POSTGRES_POOL_IDLE_TIMEOUT=30000
POSTGRES_POOL_CONNECTION_TIMEOUT=5000

# Application settings
NODE_ENV=development

# Authentication
# REQUIRED in production: signing key for session cookies (min 32 chars)
#   generate with: openssl rand -hex 32
SESSION_SECRET=
# Session lifetime in hours (default 12)
SESSION_TTL_HOURS=12
# Set to false only when serving over plain http outside localhost
COOKIE_SECURE=true
# First-run admin: created only when the users table is empty (password min 12 chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Largest request body in bytes before the server answers 413 (adapter-node default is 512K)
# BODY_SIZE_LIMIT=512K

# Requests per minute one person (or address) may make to /api/*; 0 turns the limit off
# API_RATE_LIMIT_PER_MINUTE=1200

# Peer-to-peer data sharing over IPFS (admins only). Off unless exactly "true": anything published is
# public on the IPFS network and copies others fetch cannot be recalled. See docs-site/guide/data-sharing.md first.
# IPFS_ENABLED=false
# IPFS_BLOCKSTORE_PATH=/data/ipfs/blocks
# IPFS_DATASTORE_PATH=/data/ipfs/datastore
# IPFS_GATEWAY_URL=https://ipfs.io/ipfs
# IPFS_FETCH_TIMEOUT_MS=120000
# IPFS_MAX_FETCH_BYTES=268435456
# Node network behaviour (defaults are libp2p's). Comma-separated multiaddrs; only the exact string "false" turns a switch off.
# IPFS_LISTEN_ADDRS=/ip4/0.0.0.0/tcp/4001
# IPFS_ANNOUNCE_ADDRS=/dns4/data.example.org/tcp/4001
# IPFS_UPNP=true
# IPFS_RELAY_SERVER=true
# IPFS_AUTOTLS=true
# PACKAGES_DIR=/data/packages
# MAX_EXPORT_ROWS=500000
