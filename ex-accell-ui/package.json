{
	"name": "ex-accell-ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 0.0.0.0",
		"dev:jupyter": "./scripts/start-dev.sh",
		"dev:dapr": "dapr run -f ./dapr.yaml 2>&1 | node scripts/tee-monitor.cjs",
		"dev:dapr:verbose": "dapr run -f ./dapr.yaml 2>&1 | node scripts/monitor-crawler-logs.cjs",
		"dev:dapr:plain": "dapr run -f ./dapr.yaml",
		"build": "vite build",
		"preview": "vite preview",
		"preview:dapr": "dapr run -f ./dapr.yaml --build-only && npm run preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"brand:palette": "tsx scripts/brand-palette.ts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:unit:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test": "npm run test:unit && npm run test:e2e",
		"test:full": "npm run check && npm run build && npm run test",
		"jupyter:start": "./scripts/start-jupyter.sh",
		"jupyter:bootstrap": "poetry install && poetry run python scripts/bootstrap_notebooks.py",
		"dapr:init": "dapr init",
		"dapr:setup": "./scripts/setup-deployment.sh",
		"dapr:stop": "dapr stop --app-id ex-accell-ui; dapr stop --app-id telegram-scraper; pkill -f 'vite dev' || true; pkill -f 'telegram-scraper' || true; pkill -f 'daprd' || true",
		"dapr:logs": "tail -f dapr-run.log",
		"test:integration": "node scripts/test-dapr-job-integration.js",
		"seed:demo": "tsx scripts/seed-demo.ts",
		"demo": "./scripts/demo.sh",
		"docs:screenshots": "playwright test -c playwright.screenshots.config.ts"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/aspect-ratio": "^0.4.2",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/postcss": "^4.1.11",
		"@tailwindcss/typography": "^0.5.16",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@vitest/coverage-v8": "^4.1.3",
		"autoprefixer": "^10.4.21",
		"jsdom": "^29.0.2",
		"postcss": "^8.5.6",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.1.11",
		"tsx": "^4.23.15",
		"typescript": "^5.0.0",
		"vite": "^7.0.4",
		"vitest": "^4.1.3"
	},
	"dependencies": {
		"@dapr/dapr": "^3.5.2",
		"@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@helia/unixfs": "^7.1.0",
		"@tailwindcss/vite": "^4.1.11",
		"@types/d3": "^7.4.3",
		"@types/pg": "^8.15.6",
		"@types/uuid": "^10.0.0",
		"blockstore-fs": "^3.0.2",
		"countries-list": "^3.1.1",
		"d3": "^7.9.0",
		"d3-cloud": "^2.0.0",
		"dapr-client": "^3.4.0",
		"datastore-level": "^12.0.2",
		"dotenv": "^17.4.2",
		"echarts": "^6.1.0",
		"helia": "^6.0.22",
		"http-proxy-middleware": "^3.0.5",
		"leaflet": "^1.9.4",
		"pg": "^8.16.3",
		"undici": "^7.30.2",
		"uuid": "^14.0.3"
	},
	"overrides": {
		"image-size": "^2.1.0",
		"qs": "^6.17.1"
	}
}
