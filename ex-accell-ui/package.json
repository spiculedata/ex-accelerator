{
	"name": "ex-accell-ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:dapr": "dapr run --app-id ex-accell-ui --app-port 5173 --dapr-http-port 3500 --dapr-grpc-port 50001 --components-path ./components --config ./dapr.yaml -- npm run dev",
		"build": "vite build",
		"preview": "vite preview",
		"preview:dapr": "dapr run --app-id ex-accell-ui --app-port 4173 --dapr-http-port 3500 --dapr-grpc-port 50001 --components-path ./components --config ./dapr.yaml -- npm run preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dapr:init": "dapr init",
		"dapr:stop": "dapr stop --app-id ex-accell-ui"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/aspect-ratio": "^0.4.2",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/postcss": "^4.1.11",
		"@tailwindcss/typography": "^0.5.16",
		"autoprefixer": "^10.4.21",
		"postcss": "^8.5.6",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.1.11",
		"typescript": "^5.0.0",
		"vite": "^7.0.4"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.1.11"
	}
}
