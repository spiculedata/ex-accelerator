{
	"name": "ex-accell-ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:jupyter": "./scripts/start-dev.sh",
		"dev:dapr": "dapr run -f ./dapr.yaml 2>&1 | node scripts/tee-monitor.cjs",
		"dev:dapr:verbose": "dapr run -f ./dapr.yaml 2>&1 | node scripts/monitor-crawler-logs.cjs",
		"dev:dapr:plain": "dapr run -f ./dapr.yaml",
		"build": "vite build",
		"preview": "vite preview",
		"preview:dapr": "dapr run -f ./dapr.yaml --build-only && npm run preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"cypress:open": "cypress open",
		"cypress:run": "cypress run",
		"cypress:component": "cypress run --component",
		"test:e2e": "cypress run --e2e",
		"test:component": "cypress run --component",
		"test": "npm run cypress:run",
		"test:full": "npm run check && npm run build && npm run cypress:run",
		"jupyter:start": "poetry run jupyter lab --port=8888 --no-browser --allow-root",
		"jupyter:bootstrap": "poetry install && poetry run python scripts/bootstrap_notebooks.py",
		"dapr:init": "dapr init",
		"dapr:setup": "./scripts/setup-deployment.sh",
		"dapr:stop": "dapr stop --app-id ex-accell-ui; dapr stop --app-id telegram-scraper; pkill -f 'vite dev' || true; pkill -f 'telegram-scraper' || true; pkill -f 'daprd' || true",
		"dapr:logs": "tail -f dapr-run.log",
		"test:integration": "node scripts/test-dapr-job-integration.js"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/aspect-ratio": "^0.4.2",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/postcss": "^4.1.11",
		"@tailwindcss/typography": "^0.5.16",
		"autoprefixer": "^10.4.21",
		"cypress": "^14.5.3",
		"postcss": "^8.5.6",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.1.11",
		"typescript": "^5.0.0",
		"vite": "^7.0.4"
	},
	"dependencies": {
		"@dapr/dapr": "^3.5.2",
		"@duckdb/node-api": "^1.3.2-alpha.25",
		"@helia/unixfs": "^7.1.0",
		"@tailwindcss/vite": "^4.1.11",
		"@types/pg": "^8.15.6",
		"@types/uuid": "^10.0.0",
		"blockstore-fs": "^3.0.2",
		"countries-list": "^3.1.1",
		"dapr-client": "^3.4.0",
		"datastore-level": "^12.0.2",
		"echarts": "^5.6.0",
		"helia": "^6.0.22",
		"http-proxy-middleware": "^3.0.5",
		"leaflet": "^1.9.4",
		"pg": "^8.16.3",
		"uuid": "^13.0.0"
	}
}
