{
  "body": {
    "data": {
      "actors": [
        {
          "actor": "A",
          "avg_goldstein": -2,
          "avg_tone": 2,
          "cnt": 4,
          "content": "hello #tag world",
          "count": 3,
          "created_at": "2024-01-02T00:00:00Z",
          "engagement_rate": 1.5,
          "eventrootcode": "14",
          "id": 1,
          "keyword": "k",
          "mentions": 2,
          "platform": "telegram",
          "present": true,
          "sentiment_category": "Positive",
          "text": "hello world",
          "total_events": 5,
          "unique_actors": 3,
        },
      ],
      "pairs": [
        {
          "actor": "A",
          "avg_goldstein": -2,
          "avg_tone": 2,
          "cnt": 4,
          "content": "hello #tag world",
          "count": 3,
          "created_at": "2024-01-02T00:00:00Z",
          "engagement_rate": 1.5,
          "eventrootcode": "14",
          "id": 1,
          "keyword": "k",
          "mentions": 2,
          "platform": "telegram",
          "present": true,
          "sentiment_category": "Positive",
          "text": "hello world",
          "total_events": 5,
          "unique_actors": 3,
        },
      ],
    },
    "success": true,
  },
  "queries": [
    [
      "WITH actor_mentions AS ( SELECT actor1name AS actor, actor1countrycode AS country_code, avgtone, goldsteinscale FROM gdelt_events WHERE sqldate::text >= REPLACE($1, '-', '') AND sqldate::text <= REPLACE($2, '-', '') AND (actor1name ILIKE ANY($3::text[]) OR actor2name ILIKE ANY($3::text[])) AND actor1name IS NOT NULL AND actor1name != '' UNION ALL SELECT actor2name AS actor, actor2countrycode AS country_code, avgtone, goldsteinscale FROM gdelt_events WHERE sqldate::text >= REPLACE($1, '-', '') AND sqldate::text <= REPLACE($2, '-', '') AND (actor1name ILIKE ANY($3::text[]) OR actor2name ILIKE ANY($3::text[])) AND actor2name IS NOT NULL AND actor2name != '' ) SELECT actor, country_code, COUNT(*) AS mention_count, ROUND(AVG(avgtone::numeric), 2) AS avg_tone, ROUND(AVG(goldsteinscale::numeric), 2) AS avg_goldstein FROM actor_mentions GROUP BY actor, country_code ORDER BY mention_count DESC LIMIT $4",
      [
        "2024-01-01",
        "2024-01-31",
        [
          "%alpha%",
          "%beta%",
        ],
        7,
      ],
    ],
    [
      "SELECT actor1name AS source_actor, actor2name AS target_actor, COUNT(*) AS weight FROM gdelt_events WHERE sqldate::text >= REPLACE($1, '-', '') AND sqldate::text <= REPLACE($2, '-', '') AND (actor1name ILIKE ANY($3::text[]) OR actor2name ILIKE ANY($3::text[])) AND actor1name IS NOT NULL AND actor1name != '' AND actor2name IS NOT NULL AND actor2name != '' GROUP BY actor1name, actor2name ORDER BY weight DESC LIMIT 50",
      [
        "2024-01-01",
        "2024-01-31",
        [
          "%alpha%",
          "%beta%",
        ],
      ],
    ],
  ],
  "status": 200,
}
`;

