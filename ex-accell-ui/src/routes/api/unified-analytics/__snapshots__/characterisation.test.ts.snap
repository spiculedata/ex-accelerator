exports[`unified-analytics characterisation > investigation-timeline > rich 1`] = `
{
  "body": {
    "data": [
      {
        "actor": "A",
        "avg_goldstein": -2,
        "avg_tone": 2,
        "cnt": 4,
        "content": "hello #tag world",
        "count": 3,
        "created_at": "2024-01-02T00:00:00Z",
        "engagement_rate": 1.5,
        "eventrootcode": "14",
        "id": 1,
        "keyword": "k",
        "mentions": 2,
        "platform": "telegram",
        "present": true,
        "sentiment_category": "Positive",
        "text": "hello world",
        "total_events": 5,
        "unique_actors": 3,
      },
    ],
    "success": true,
  },
  "queries": [
    [
      "SELECT to_regclass('gdelt_events') IS NOT NULL AS gdelt, to_regclass('radio_transcripts') IS NOT NULL AS radio",
      [],
    ],
    [
      "WITH date_series AS ( SELECT generate_series($1::date, $2::date, '1 day'::interval)::date AS d ), gdelt AS (SELECT NULL::date AS d, 0::bigint AS event_count, NULL::float8 AS avg_goldstein, NULL::float8 AS avg_tone WHERE false), radio AS (SELECT NULL::date AS d, 0::bigint AS segment_count, 0::bigint AS positive, 0::bigint AS negative, 0::bigint AS neutral WHERE false), social AS ( SELECT DATE(to_timestamp(timestamp/1000)) AS d, COUNT(*) AS post_count, COUNT(*) FILTER (WHERE sentiment_category IN ('Positive','Very Positive')) AS positive, COUNT(*) FILTER (WHERE sentiment_category IN ('Negative','Very Negative')) AS negative, COUNT(*) FILTER (WHERE sentiment_category = 'Neutral') AS neutral FROM posts_with_sentiment WHERE to_timestamp(timestamp/1000) >= $1::timestamp AND to_timestamp(timestamp/1000) <= ($2::date + 1)::timestamp AND text ILIKE ANY($3::text[]) GROUP BY 1 ) SELECT ds.d as date, COALESCE(g.event_count, 0) as gdelt_events, g.avg_goldstein, g.avg_tone, COALESCE(r.segment_count, 0) as radio_segments, COALESCE(r.positive, 0) as radio_positive, COALESCE(r.negative, 0) as radio_negative, COALESCE(r.neutral, 0) as radio_neutral, COALESCE(s.post_count, 0) as social_posts, COALESCE(s.positive, 0) as social_positive, COALESCE(s.negative, 0) as social_negative, COALESCE(s.neutral, 0) as social_neutral FROM date_series ds LEFT JOIN gdelt g ON g.d = ds.d LEFT JOIN radio r ON r.d = ds.d LEFT JOIN social s ON s.d = ds.d ORDER BY ds.d",
      [
        "2024-01-01",
        "2024-01-31",
        [
          "%alpha%",
          "%beta%",
        ],
      ],
    ],
  ],
  "status": 200,
}
`;

