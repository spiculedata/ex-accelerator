exports[`unified-analytics characterisation > investigation-keyword-overlap > rich 1`] = `
{
  "body": {
    "data": [
      {
        "actor": "A",
        "avg_goldstein": -2,
        "avg_tone": 2,
        "cnt": 4,
        "content": "hello #tag world",
        "count": 3,
        "created_at": "2024-01-02T00:00:00Z",
        "engagement_rate": 1.5,
        "eventrootcode": "14",
        "id": 1,
        "keyword": "k",
        "mentions": 2,
        "platform": "telegram",
        "present": true,
        "sentiment_category": "Positive",
        "text": "hello world",
        "total_events": 5,
        "unique_actors": 3,
      },
    ],
    "success": true,
  },
  "queries": [
    [
      "WITH gdelt_mentions AS ( SELECT kw AS keyword, 'gdelt' AS source, COUNT(*) AS mention_count FROM gdelt_events CROSS JOIN unnest($3::text[]) AS kw WHERE sqldate >= CAST(REPLACE($1::text, '-', '') AS INTEGER) AND sqldate <= CAST(REPLACE($2::text, '-', '') AS INTEGER) AND (actor1name ILIKE kw OR actor2name ILIKE kw OR actiongeo_fullname ILIKE kw) GROUP BY kw ), radio_mentions AS ( SELECT kw AS keyword, 'radio' AS source, COUNT(*) AS mention_count FROM radio_transcripts CROSS JOIN unnest($3::text[]) AS kw WHERE segment_start >= $1::timestamp AND segment_start <= ($2::date + 1)::timestamp AND transcript ILIKE kw GROUP BY kw ), social_mentions AS ( SELECT kw AS keyword, 'social' AS source, COUNT(*) AS mention_count FROM posts_with_sentiment CROSS JOIN unnest($3::text[]) AS kw WHERE to_timestamp(timestamp/1000) >= $1::timestamp AND to_timestamp(timestamp/1000) <= ($2::date + 1)::timestamp AND text ILIKE kw GROUP BY kw ), combined AS ( SELECT * FROM gdelt_mentions UNION ALL SELECT * FROM radio_mentions UNION ALL SELECT * FROM social_mentions ) SELECT REPLACE(keyword, '%', '') AS keyword, COALESCE(SUM(mention_count) FILTER (WHERE source = 'gdelt'), 0) AS gdelt_count, COALESCE(SUM(mention_count) FILTER (WHERE source = 'radio'), 0) AS radio_count, COALESCE(SUM(mention_count) FILTER (WHERE source = 'social'), 0) AS social_count FROM combined GROUP BY keyword ORDER BY (COALESCE(SUM(mention_count) FILTER (WHERE source = 'gdelt'), 0) + COALESCE(SUM(mention_count) FILTER (WHERE source = 'radio'), 0) + COALESCE(SUM(mention_count) FILTER (WHERE source = 'social'), 0)) DESC",
      [
        "2024-01-01",
        "2024-01-31",
        [
          "%alpha%",
          "%beta%",
        ],
      ],
    ],
  ],
  "status": 200,
}
`;

