      "SELECT p.id, p.content AS text, l.code AS language_code, l.name AS language_name, ld.confidence_score AS confidence, CAST(p.created_at AS TEXT) AS timestamp, ds.platform, (SELECT l2.code FROM language_mixing lm JOIN languages l2 ON l2.id = lm.secondary_language_id WHERE lm.post_id = p.id ORDER BY lm.id LIMIT 1) AS secondary_language, (SELECT lm.secondary_confidence FROM language_mixing lm WHERE lm.post_id = p.id ORDER BY lm.id LIMIT 1) AS secondary_confidence FROM language_detection ld JOIN languages l ON l.id = ld.language_id JOIN posts p ON p.id = ld.post_id JOIN data_sources ds ON ds.id = p.data_source_id WHERE ds.platform = $1 AND l.code = $2 AND ld.confidence_score >= $3 AND p.created_at >= $4 AND p.created_at < $5 ORDER BY p.created_at DESC LIMIT $6",
      [
        "telegram",
        "en",
        0.4,
        "2024-01-01T00:00:00.000Z",
        "2024-02-01T00:00:00.000Z",
        7,
      ],
    ],
  ],
  "status": 200,
}
`;

