exports[`unified-analytics characterisation > engagement-content-types > database error 1`] = `
{
  "body": {
    "data": null,
    "error": "Query failed",
    "success": false,
  },
  "queries": [
    [
      "SELECT COALESCE(ct.name, 'Unknown') AS content_type, COUNT(*) AS posts, COALESCE(AVG(pe.engagement_rate), 0) AS engagement_rate, COALESCE(SUM(pe.reach), 0) AS reach, COALESCE(AVG(pe.likes_count), 0) AS avg_likes, COALESCE(AVG(pe.comments_count), 0) AS avg_comments, COALESCE(AVG(pe.shares_count), 0) AS avg_shares, COALESCE(AVG(CASE WHEN EXISTS ( SELECT 1 FROM sentiment_classifications sc WHERE sc.post_id = p.id AND sc.sentiment_category IN ('Very Positive', 'Positive') ) THEN 1.0 ELSE 0.0 END), 0) AS positive_share FROM post_engagement pe JOIN posts p ON p.id = pe.post_id JOIN data_sources ds ON ds.id = p.data_source_id LEFT JOIN content_types ct ON ct.id = pe.content_type_id GROUP BY COALESCE(ct.name, 'Unknown') ORDER BY engagement_rate DESC",
      [],
    ],
  ],
  "status": 500,
}
`;

