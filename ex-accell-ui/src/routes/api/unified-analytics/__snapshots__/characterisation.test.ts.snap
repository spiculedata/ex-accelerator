    "data": [
      {
        "actor": "A",
        "avg_goldstein": -2,
        "avg_tone": 2,
        "cnt": 4,
        "content": "hello #tag world",
        "count": 3,
        "created_at": "2024-01-02T00:00:00Z",
        "engagement_rate": 1.5,
        "eventrootcode": "14",
        "id": 1,
        "keyword": "k",
        "mentions": 2,
        "platform": "telegram",
        "present": true,
        "sentiment_category": "Positive",
        "text": "hello world",
        "total_events": 5,
        "unique_actors": 3,
      },
    ],
    "success": true,
  },
  "queries": [
    [
      "SELECT p.id, p.content AS text, p.author, ds.platform, COALESCE(ct.name, 'Unknown') AS content_type, pe.likes_count AS likes, pe.comments_count AS comments, pe.shares_count AS shares, pe.saves_count AS saves, pe.engagement_rate, pe.reach, pe.views_count AS views, p.created_at AS timestamp FROM post_engagement pe JOIN posts p ON p.id = pe.post_id JOIN data_sources ds ON ds.id = p.data_source_id LEFT JOIN content_types ct ON ct.id = pe.content_type_id ORDER BY (pe.likes_count + pe.comments_count + pe.shares_count + pe.saves_count) DESC LIMIT $1",
      [
        10,
      ],
    ],
  ],
  "status": 200,
}
`;

