  "queries": [
    [
      "SELECT to_regclass('silver.posts') IS NOT NULL AS present",
      [],
    ],
    [
      "WITH hashtag_extract AS ( SELECT unnest(regexp_matches(content, '#([A-Za-z0-9_]+)', 'g')) as hashtag, post_id as post_id, media_type as media_type FROM silver.posts WHERE content IS NOT NULL AND content LIKE '%#%' ) SELECT lower(hashtag) as hashtag, COUNT(*) as count, COUNT(DISTINCT post_id) as post_count, array_agg(DISTINCT media_type) as platforms FROM hashtag_extract GROUP BY lower(hashtag) HAVING COUNT(*) >= 2 ORDER BY count DESC LIMIT $1",
      [
        50,
      ],
    ],
    [
      "WITH hashtag_extract AS ( SELECT post_id as post_id, unnest(regexp_matches(content, '#([A-Za-z0-9_]+)', 'g')) as hashtag FROM silver.posts WHERE content IS NOT NULL AND content LIKE '%#%' ), pairs AS ( SELECT a.hashtag as h1, b.hashtag as h2 FROM hashtag_extract a JOIN hashtag_extract b ON a.post_id = b.post_id AND lower(a.hashtag) < lower(b.hashtag) ) SELECT lower(h1) as hashtag1, lower(h2) as hashtag2, COUNT(*) as co_count FROM pairs GROUP BY lower(h1), lower(h2) HAVING COUNT(*) >= 2 ORDER BY co_count DESC LIMIT 20",
      [],
    ],
  ],
